[Unit]
Description=gocamdet — watch USB camera/microphone in-use state and run a hook on transitions
Documentation=https://github.com/emergingrobotics/gocamdet
After=multi-user.target

[Service]
Type=simple
# Runs as root so process attribution is complete (full visibility).
ExecStart=/usr/local/bin/gocamdet --watch --interval 2s --script /etc/gocamdet/hook.sh
Restart=on-failure
RestartSec=5
# gocamdet reads only sysfs/procfs and executes the configured hook under /etc.
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
